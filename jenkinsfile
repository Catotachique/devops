pipeline {
    agent any
    stages {
        stage('Checkout') {
            steps {
                echo 'Checking out code...' // Placeholder step
            }
        }
        stage('Build') {
            when {
                branch 'main' // Or some other condition
            }
            steps {
                sh 'echo "Building the project..."' // Example
            }
        }
        stage('Test') {
            when {
                branch 'develop' // Or some other condition
            }
            steps {
                sh 'echo "Running tests..."' // Example
            }
        }
        stage('Deploy') {
            steps {
                sh 'echo "Deploying the project..."' // Example
            }
        }
    }
}